# ═══════════════════════════════════════════════════════════════════════════════
# BlueAgle Server — Environment Variables Reference (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# This file is safe to commit — it contains NO real credentials.
#
# For development: copy this file to .env.local and fill in your local values.
# For production:  copy this file to .env and fill in your production values.
#
# Development:  npm run dev  → loads .env.local
# Production:   npm start    → loads .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
# Set to 'production' on your hosting server, 'development' locally.
# This is automatically set by npm run dev / npm start via cross-env.
NODE_ENV=development
PORT=5000

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=root
DB_PASS=your_db_password_here
DB_DIALECT=mysql

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Development example: http://localhost:5173
# Production example:  https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ── App URLs ──────────────────────────────────────────────────────────────────
# SITE_URL    — The public-facing frontend domain (used in sitemap, canonical URLs, OG tags)
# CLIENT_URL  — Alias for SITE_URL (used in some utilities)
# FRONTEND_URL— Used for generating admin email links (invitations, password reset)
# APP_URL     — The backend API base URL
SITE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Use UNIQUE values for each secret.
# NEVER share or reuse secrets between development and production.
JWT_SECRET=replace_with_64_char_random_hex
ADMIN_JWT_SECRET=replace_with_different_64_char_random_hex
ADMIN_JWT_EXPIRY=15m
ADMIN_REFRESH_TOKEN_EXPIRY=7d

# ── Initial Super Admin (seeder only) ─────────────────────────────────────────
# IMPORTANT: Change the password immediately after first login.
INITIAL_ADMIN_EMAIL=superadmin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ChangeThisImmediately!
INITIAL_ADMIN_FIRSTNAME=Super
INITIAL_ADMIN_LASTNAME=Admin

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Provide the full JSON content of your Firebase service account key as a string.
# Download from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Format: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# In development, if this is not set, the server runs with an unverified token fallback.
# In production, this MUST be set — the server will refuse to start without it.
FIREBASE_SERVICE_ACCOUNT=

# ── ImageKit (Image & Video CDN) ──────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Razorpay (Payment Gateway) ────────────────────────────────────────────────
# Development: use test keys (rzp_test_...)
# Production:  use live keys (rzp_live_...)
# NEVER expose RAZORPAY_KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for admin invitations, password resets, and account deletion confirmations.
# Leave blank in development — falls back to console logging automatically.
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── Google Analytics 4 (GA4) ─────────────────────────────────────────────────
# Backend integration for server-side reporting via GA4 Data API.
# These are NEVER exposed to the frontend.
# The service account must have "Viewer" or "Analyst" access on your GA4 Property.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SERVICE_ACCOUNT_EMAIL=analytics-reader@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
